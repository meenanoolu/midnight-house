# Copy this file to .env (same folder as requirements.txt). It is loaded automatically.
# Pick ONE provider:
#   mock   = no model, canned replies (always works)
#   ollama = local model (run `ollama serve`, `ollama pull gemma3`)
#   openai = any OpenAI-compatible hosted endpoint (set the three LLM_* vars)
LLM_PROVIDER=mock
OLLAMA_MODEL=gemma3
# Fallback chain (like Deis): try local Ollama first, then hosted Gemma endpoints.
# LLM_CHAIN=ollama,openai,openai2
# LLM_BASE_URL_2=https://openrouter.ai/api/v1
# LLM_API_KEY_2=
# LLM_MODEL_2=
# OLLAMA_HOST=http://localhost:11434
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Optional extras (leave empty to disable)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
MONGODB_URI=
SENTRY_DSN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
